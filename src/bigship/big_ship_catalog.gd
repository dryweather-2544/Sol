extends RefCounted
## The five big ships. Each has its own hull model, its own interior (see big_ship_data.gd, generated by tools/gen_big_ships.py) and its own numbers.

const Def := preload("res://src/bigship/big_ship_def.gd")

const CC_BY := "licensed under CC-BY-4.0 (http://creativecommons.org/licenses/by/4.0/)"

static var _all: Array = []

## Nozzle positions (ship space) and radii per ship, found from each hull model's geometry with tools/engine_detect.py (the Talon's are the
## rear ends of its four lift-fan nacelles; the Halo's drum has no nozzles, so it burns from its stern; the Kestrel's are the fighter hull's, scaled).
const ENGINES := {
	"meridian": [[Vector3(-30.1, -8.3, 68.7), 6.0], [Vector3(30.1, -8.3, 68.7), 6.0]],
	"talon": [[Vector3(-23.9, 2.2, 17.1), 2.0], [Vector3(23.9, 2.2, 17.1), 2.0], [Vector3(-10.2, 1.5, -4.8), 2.0], [Vector3(10.2, 1.5, -4.8), 2.0]],
	"argent": [[Vector3(-19.7, 1.2, 33.8), 5.0], [Vector3(19.7, 1.2, 33.8), 5.0], [Vector3(0.0, 4.4, 44.2), 2.5]],
	"halo": [[Vector3(-7.0, 0.0, 22.3), 3.0], [Vector3(7.0, 0.0, 22.3), 3.0]],
	"kestrel": [[Vector3(-15.1, -6.1, 37.9), 4.0], [Vector3(15.1, -6.1, 37.9), 4.0]],
}


static func all() -> Array:
	if _all.is_empty():
		_build()
	return _all


static func by_id(ship_id: String) -> Def:
	for def in all():
		if def.id == ship_id:
			return def
	return null


static func _build() -> void:
	_all.append(_make("meridian", "Meridian", "Long-haul freighter",
		"A freight tug built round one 27 m spine corridor: the bridge at the nose, crew rooms either side, then a twenty-metre cargo hold and the engine deck.",
		"res://assets/ships/hulls/cargo_spaceship/scene.gltf", 140.0, 0.0, 12, 9000, "Slow", Color(0.95, 0.62, 0.2),
		"This work is based on \"Cargo Spaceship\" (https://sketchfab.com/3d-models/cargo-spaceship-a53147cc2da943e7ae07f1e0b0a31518) by blaice (https://sketchfab.com/blaice) " + CC_BY))
	_all.append(_make("talon", "Talon", "Heavy VTOL gunship",
		"A gunship with a three-row flight deck, the captain's bay right behind it, an ops deck and a troop bay with two door guns and a rear ramp.",
		"res://assets/ships/hulls/heavy_vtol_gunship/scene.gltf", 56.0, PI, 9, 40, "Fast", Color(0.85, 0.25, 0.22),
		"This work is based on \"Heavy VTOL gunship\" (https://sketchfab.com/3d-models/heavy-vtol-gunship-86d336e0fa6f40329de8cda4a71d8a17) by Kai Xiang (https://sketchfab.com/kirikom9000) " + CC_BY))
	_all.append(_make("argent", "Argent", "Merchant liner",
		"A trade liner: a long gangway drops from the bridge into a garden atrium, and eight passenger cabins run aft down two corridors to the stern hall.",
		"res://assets/ships/hulls/space_cargo_ship_transporter/scene.gltf", 118.0, 0.0, 20, 1200, "Medium", Color(0.8, 0.8, 0.9),
		"This work is based on \"Space Cargo Ship Transporter\" (https://sketchfab.com/3d-models/space-cargo-ship-transporter-76c18dcb6a0043d6ab05ed9f9c26330b) by Inditrion Dradnon (https://sketchfab.com/dradnon) " + CC_BY))
	_all.append(_make("halo", "Halo", "Ring transport",
		"A ring ship: a square corridor runs right round the hull, with the reactor hall, the shuttle bay and a bridge whose crew sit in two banks facing a holo table inside it.",
		"res://assets/ships/hulls/space_cargo_transporter/scene.gltf", 52.0, 0.0, 16, 3500, "Medium", Color(0.3, 0.75, 0.9),
		"This work is based on \"Space Cargo Transporter\" (https://sketchfab.com/3d-models/space-cargo-transporter-1a6e7bdc47a347749b424835dca3745d) by kunyong_Chen (https://sketchfab.com/cky666) " + CC_BY))
	_all.append(_make("kestrel", "Kestrel", "Survey corvette",
		"A survey corvette: an observation lounge and the captain's bay flank the bridge, a gallery of labs and a greenhouse lie behind it, and one aft corridor runs to the engines.",
		"res://assets/fighters/fighter_20.glb", 84.0, PI, 14, 300, "Fast", Color(0.45, 0.8, 0.45), ""))


static func _make(ship_id: String, display_name: String, ship_class: String, blurb: String, hull_path: String, hull_extent: float, hull_yaw: float,
		crew: int, cargo_tons: int, speed_class: String, accent: Color, credit: String) -> Def:
	var def := Def.new()
	def.id = ship_id
	def.display_name = display_name
	def.ship_class = ship_class
	def.blurb = blurb
	def.hull_path = hull_path
	def.hull_extent = hull_extent
	def.hull_yaw = hull_yaw
	def.crew = crew
	def.cargo_tons = cargo_tons
	def.speed_class = speed_class
	def.accent = accent
	def.credit = credit
	for entry in ENGINES.get(ship_id, []):
		def.engines.append(entry[0])
		def.engine_radii.append(entry[1])
	return def
