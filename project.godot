; Engine configuration file.
; Written by hand in the cloud session (Godot was not available to generate it).
; Open the project once in Godot 4.7.2 on the Mac; the editor may rewrite this file.

config_version=5

[application]

config/name="Sol"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
